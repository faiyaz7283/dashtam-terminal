# =============================================================================
# Dashtam Terminal - Environment Variables
# =============================================================================
# Copy this file to .env.dev and configure for your environment

# Dashtam API connection
DASHTAM_API_URL=https://dashtam.local
DASHTAM_WS_URL=wss://dashtam.local/ws

# Default profile
DASHTAM_PROFILE=dev

# Logging
LOG_LEVEL=DEBUG
